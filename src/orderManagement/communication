package orderManagement

import (
	"fmt"
	"heislab/management"
	"heislab/hallRequestAssigner"
	"strconv"
	"sync"
	"time"
)

func MergeGlobalState(senderID string, gs GlobalStateType) {
	GlobalStateMutex.Lock()
	defer GlobalStateMutex.Unlock()

	localID := strconv.Itoa(management.Elev.ID)

	// Oppdater kun senderens state
	if senderID != localID { // ignorer egen state
		if st, exists := gs.States[senderID]; exists {
			GlobalState.States[senderID] = st
		}
	}

	// Merge hall requests
	for f := 0; f < management.NumFloors; f++ {
		for b := 0; b < 2; b++ {
			GlobalState.HallRequests[f][b] = GlobalState.HallRequests[f][b] || gs.HallRequests[f][b]
		}
	}
}

// SendGlobalStatePeriodically sends GlobalState over the network every interval
func SendGlobalStatePeriodically(tx chan<- network.Envelope[GlobalStateType], interval time.Duration) {
	ticker := time.NewTicker(interval)
	defer ticker.Stop()

	localID := strconv.Itoa(management.Elev.ID)

	for range ticker.C {
		UpdateLocalGlobalState() // oppdater GlobalState med egen heis info
		GlobalStateMutex.Lock()
		payload := GlobalState
		GlobalStateMutex.Unlock()

		tx <- network.Envelope[GlobalStateType]{
			SenderID: localID,
			Payload:  payload,
		}
	}
}

func ListenAndMergeGlobalState(rx <-chan GlobalStateType) {
	for gs := range rx {
		MergeGlobalState(gs)
		fmt.Println("Merged GlobalState from network")
	}
}